        <mxCell id="note" value="&lt;b&gt;Enums&lt;/b&gt;&lt;br&gt;AccountType: USER, SYSTEM&lt;br&gt;SystemAccountCode: EXTERNAL&lt;br&gt;TransactionType: DEPOSIT, WITHDRAW, TRANSFER&lt;br&gt;TransactionStatus: PENDING, COMPLETED, FAILED&lt;br&gt;EntryType: DEBIT, CREDIT&lt;br&gt;&lt;br&gt;Money is &lt;b&gt;long&lt;/b&gt; in minor units (see Currency.exponent).&lt;br&gt;2..* entries: exactly 2 today (debit + credit),&lt;br&gt;drawn open for future multi-leg transactions." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fillColor=none;" vertex="1" parent="1"><mxGeometry x="620" y="600" width="300" height="170" as="geometry" /></mxCell>
